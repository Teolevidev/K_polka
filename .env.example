# ============================================================
#  Книжная полка — переменные окружения
#  Скопируй в .env.local и заполни своими значениями
# ============================================================

# --- Supabase ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — ТОЛЬКО на сервере, никогда не коммить и не использовать в браузере
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- База данных (для Drizzle-миграций) ---
# Supabase → Project Settings → Database → Connection string (URI, режим Session)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# --- Книжные API ---
# Google Books: https://console.cloud.google.com/apis/credentials (необязательно, но снимает лимиты)
GOOGLE_BOOKS_API_KEY=
# ISBNdb: https://isbndb.com/apidocs (платный, подключается в Фазе 1.5)
ISBNDB_API_KEY=
# OpenLibrary — ключ не нужен

# --- Email (Yandex Postbox / SMTP) ---
# В dev можно оставить пустым — Supabase отправит через встроенный email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- AI (рекомендации книг) ---
# https://console.anthropic.com → Settings → API Keys. Без ключа
# блок «Порекомендуй мне книгу» покажет «AI временно недоступен».
ANTHROPIC_API_KEY=

# --- Cron (Vercel) ---
# Любая длинная строка. Vercel шлёт её в Authorization-заголовке
# /api/cron/daily-reminders — без неё рассылка не запустится извне.
CRON_SECRET=

# --- Telegram (для напоминаний в Telegram, подключается отдельно) ---
TELEGRAM_BOT_TOKEN=

# --- YooKassa (Фаза 3, sandbox для разработки) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# --- Приложение ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# --- Feature flags ---
# Apple OAuth — включить, когда появится Apple Developer аккаунт
NEXT_PUBLIC_FEATURE_APPLE_AUTH=false
# Платный клуб — false = весь контент доступен всем зарегистрированным (soft launch)
NEXT_PUBLIC_FEATURE_PAID_CLUB=false
# LiveLib scraper — включить осторожно, может быть нестабилен
FEATURE_LIVELIB_SCRAPER=false
